if SHIELD_CAGIME_AAA_LEFT || SHIELD_CAGIME_AAA_RIGHT

config ZMK_SPLIT
    default y

config ZMK_KEYBOARD_NAME
    default "CaGiMe"

if SHIELD_CAGIME_AAA_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 1

endif
endif

if SHIELD_CAGIME_AAA_RIGHT || SHIELD_CAGIME_AAA_LEFT_J5

